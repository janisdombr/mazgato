            "required": true
        },
        "work": {
            "type": "link",
            "required": true
        },
        "service": {
            "type": "link",
            "tooltip": true
        },
        "role": {
            "type": "link",
            "tooltip": true
        },
        "employee": {
            "type": "link",
            "tooltip": true
        },
        "rate": {
            "type": "currency",
            "tooltip": true
        },
        "share": {
            "type": "float",
