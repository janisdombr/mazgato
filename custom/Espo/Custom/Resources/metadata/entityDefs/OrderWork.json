        "amountManual": {
            "type": "bool",
            "readOnly": true,
            "tooltip": true
        },
        "startedAt": {
            "type": "datetime",
            "readOnly": true,
            "tooltip": true
        },
        "doneAt": {
            "type": "datetime",
            "tooltip": true
        },
        "doneBy": {
            "type": "link",
            "readOnly": true,
            "tooltip": true
        },
        "doneDevice": {
            "type": "link",
            "readOnly": true,
            "tooltip": true
        }
    },
    "links": {
        "washOrder": {
            "type": "belongsTo",
            "entity": "WashOrder",
            "foreign": "orderWorks"
        },
        "work": {
            "type": "belongsTo",
            "entity": "Work",
            "foreign": "orderWorks"
        },
        "service": {
