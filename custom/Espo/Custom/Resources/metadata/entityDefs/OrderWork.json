    "collection": {
        "orderBy": "createdAt",
        "order": "asc"
    },
    "indexes": {
        "washOrder": {
            "columns": [
                "washOrderId",
                "deleted"
            ]
        },
        "employee": {
            "columns": [
                "employeeId",
                "deleted"
