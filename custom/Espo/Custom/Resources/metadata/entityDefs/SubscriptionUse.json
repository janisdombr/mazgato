        },
        "washOrder": {
            "type": "link",
            "required": true
        },
        "usedAt": {
            "type": "datetime"
        },
        "refundedAt": {
            "type": "datetime"
        },
        "listPrice": {
            "type": "currency",
            "tooltip": true
        },
