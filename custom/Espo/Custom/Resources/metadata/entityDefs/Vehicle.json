{
    "fields": {
        "name": {
            "type": "varchar",
            "required": true,
            "trim": true,
            "pattern": "$noBadCharacters",
            "view": "custom:views/fields/plate"
        },
        "plateTemporary": {
            "type": "bool",
            "default": false,
            "readOnly": true,
            "tooltip": true
        },
        "brand": {
            "type": "varchar",
            "maxLength": 50
        },
        "model": {
            "type": "varchar",
            "maxLength": 50
        },
        "bodyType": {
            "type": "enum",
            "options": [
                "Sedan",
                "Hatchback",
                "Wagon",
                "SUV",
                "Van",
                "Truck",
                "Other"
            ],
            "default": "Sedan"
        },
        "customer": {
            "type": "link"
        },
        "orders": {
            "type": "linkMultiple",
            "noLoad": true
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        }
    },
    "links": {
        "customer": {
            "type": "belongsTo",
            "entity": "Customer",
            "foreign": "vehicles"
        },
        "orders": {
            "type": "hasMany",
            "entity": "WashOrder",
            "foreign": "vehicle"
        },
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        }
    },
    "collection": {
        "orderBy": "name",
        "order": "asc",
        "textFilterFields": [
            "name",
            "brand",
            "model"
        ]
    },
    "indexes": {
        "nameUnique": {
            "type": "unique",
            "columns": [
                "name",
                "deleted"
            ]
        }
    }
}
