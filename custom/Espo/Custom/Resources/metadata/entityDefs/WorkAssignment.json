{
    "fields": {
        "name": {
            "type": "varchar",
            "required": false,
            "pattern": "$noBadCharacters"
        },
        "washOrder": {
            "type": "link",
            "required": true
        },
        "employee": {
            "type": "link",
            "required": true
        },
        "role": {
            "type": "enum",
            "options": ["Washer", "Detailer", "Vacuum", "Polish", "Supervisor", "Other"],
            "default": "Washer"
        },
        "bonusEarned": {
            "type": "currency"
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        }
    },
    "links": {
        "washOrder": {
            "type": "belongsTo",
            "entity": "WashOrder",
            "foreign": "workAssignments"
        },
        "employee": {
            "type": "belongsTo",
            "entity": "Employee",
            "foreign": "workAssignments"
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc",
        "textFilterFields": ["name"]
    }
}
