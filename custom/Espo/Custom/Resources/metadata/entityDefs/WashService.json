{
    "fields": {
        "name": {
            "type": "varchar",
            "required": true,
            "pattern": "$noBadCharacters",
            "view": "custom:views/fields/translated-name"
        },
        "category": {
            "type": "enum",
            "options": [
                "Base",
                "Add-on"
            ],
            "default": "Base",
            "style": {
                "Base": "primary",
                "Add-on": "info"
            }
        },
        "sortOrder": {
            "type": "int",
            "min": 0,
            "default": 100,
            "tooltip": true
        },
        "priceRetail": {
            "type": "currency",
            "required": true
        },
        "priceCorporate": {
            "type": "currency"
        },
        "durationMinutes": {
            "type": "int",
            "min": 0
        },
        "isActive": {
            "type": "bool",
            "default": true
        },
        "supplyLines": {
            "type": "linkMultiple",
            "noLoad": true
        },
        "workLines": {
            "type": "linkMultiple",
            "noLoad": true
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        }
    },
    "links": {
        "orders": {
            "type": "hasMany",
            "entity": "WashOrder",
            "foreign": "service"
        },
        "addonOrders": {
            "type": "hasMany",
            "entity": "WashOrder",
            "relationName": "washOrderAddon",
            "foreign": "addons"
        },
        "supplyLines": {
            "type": "hasMany",
            "entity": "ServiceSupply",
            "foreign": "service"
        },
        "workLines": {
            "type": "hasMany",
            "entity": "ServiceWork",
            "foreign": "service"
        }
    },
    "collection": {
        "orderBy": "sortOrder",
        "order": "asc"
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        }
    }
}
