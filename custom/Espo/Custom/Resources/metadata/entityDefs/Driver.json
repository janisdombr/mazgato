{
    "fields": {
        "name": {
            "type": "varchar",
            "required": true,
            "pattern": "$noBadCharacters"
        },
        "phone": {
            "type": "varchar",
            "maxLength": 30
        },
        "email": {
            "type": "varchar",
            "maxLength": 100
        },
        "customer": {
            "type": "link",
            "tooltip": true
        },
        "isPrimary": {
            "type": "bool",
            "tooltip": true
        },
        "isActive": {
            "type": "bool",
            "default": true
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        }
    },
    "links": {
        "customer": {
            "type": "belongsTo",
            "entity": "Customer",
            "foreign": "drivers"
        },
        "orders": {
            "type": "hasMany",
            "entity": "WashOrder",
            "foreign": "driver"
        }
    },
    "collection": {
        "orderBy": "name",
        "order": "asc",
        "textFilterFields": ["name", "phone"]
    },
    "indexes": {
        "customer": {
            "columns": ["customerId", "deleted"]
        }
    }
}
